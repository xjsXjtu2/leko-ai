# 环境变量模板：cp .env.example .env && vim .env
# 阿里云百炼 API key（控制台 https://bailian.console.aliyun.com → API-KEY）
DASHSCOPE_API_KEY=

# 模型（默认 qwen-vl-plus；换豆包/GLM-4V 改下面两行，OpenAI 兼容零代码改动）
VISION_MODEL=qwen-vl-plus
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 唤醒后的指令识别（qwen3-asr-flash，同步，短句）
ASR_MODEL=qwen3-asr-flash

# 设备令牌（Pi 侧同款，python -c "import secrets; print(secrets.token_hex(16))" 生成）
DEVICE_TOKEN=
